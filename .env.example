# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (from MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/foundr

# Clerk auth keys (from dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Same Clerk publishable key, read by the client at build time (Vite only
# exposes vars prefixed VITE_). Must be set wherever `vite build` runs.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Server
PORT=3000

# Encrypts third-party access tokens at rest (Shopify connections).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
