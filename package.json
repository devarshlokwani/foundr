{
  "name": "foundr",
  "version": "0.1.0",
  "private": true,
  "description": "The simple finance tracker built for solo founders.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "waitlist": "tsx watch server/waitlist-server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "server": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.0.0",
    "@clerk/express": "^2.1.32",
    "@tabler/icons-webfont": "^3.44.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.24",
    "lit": "^3.1.4",
    "mongoose": "^8.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
